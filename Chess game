import tkinter as tk
import chess
import random

board = chess.Board()

root = tk.Tk()
root.title("Chess vs AI")

buttons = {}

def update_board():
    pieces = {
        'P': '♙', 'R': '♖', 'N': '♘', 'B': '♗', 'Q': '♕', 'K': '♔',
        'p': '♟', 'r': '♜', 'n': '♞', 'b': '♝', 'q': '♛', 'k': '♚'
    }

    for row in range(8):
        for col in range(8):
            square = chess.square(col, 7 - row)
            piece = board.piece_at(square)

            text = pieces.get(str(piece), "") if piece else ""
            buttons[(row, col)].config(text=text)

selected = None

def click(row, col):
    global selected

    square = chess.square(col, 7 - row)

    if selected is None:
        selected = square
    else:
        move = chess.Move(selected, square)

        if move in board.legal_moves:
            board.push(move)
            update_board()

            if not board.is_game_over():
                ai_move()

        selected = None

def ai_move():
    move = random.choice(list(board.legal_moves))
    board.push(move)
    update_board()

for row in range(8):
    for col in range(8):
        color = "#EEEED2" if (row + col) % 2 == 0 else "#769656"

        btn = tk.Button(
            root,
            width=4,
            height=2,
            font=("Arial", 20),
            bg=color,
            command=lambda r=row, c=col: click(r, c)
        )

        btn.grid(row=row, column=col)
        buttons[(row, col)] = btn

update_board()
root.mainloop()
